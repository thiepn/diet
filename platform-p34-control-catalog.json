{
  "schemaVersion": 2,
  "phase": "P34",
  "catalogVersion": "2026-10-03.1",
  "title": "THIEPN Security Control Catalog",
  "mappingNotice": "Internal readiness crosswalk only. It is not auditor-approved, does not map to every framework criterion, and establishes no certification or compliance claim.",
  "frameworkBasis": {
    "nistCsf20": {
      "version": "2.0",
      "functions": [
        "GOVERN",
        "IDENTIFY",
        "PROTECT",
        "DETECT",
        "RESPOND",
        "RECOVER"
      ],
      "mappingLevel": "function_level_internal_crosswalk"
    },
    "soc2Readiness": {
      "basis": "AICPA Trust Services Criteria",
      "domains": [
        "Security",
        "Availability",
        "Processing Integrity",
        "Confidentiality",
        "Privacy"
      ],
      "mappingLevel": "high_level_domain_internal_crosswalk"
    }
  },
  "controls": [
    {
      "id": "TH-GV-01",
      "title": "Change governance and reviewed release admission",
      "owner": "platform",
      "objective": "Production-impacting change is classified, reviewed, evidenced and routed through governed admission/release controls.",
      "nist": [
        "GOVERN"
      ],
      "soc2": [
        "Security",
        "Processing Integrity"
      ],
      "frequency": "per_change",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P29 compatibility",
        "P30 promotion",
        "P31 can-release",
        "P32 admission",
        "P33 provenance",
        "GitHub PR/workflow identity"
      ],
      "test": "governed_change_chain"
    },
    {
      "id": "TH-GV-02",
      "title": "Resource ownership and lifecycle governance",
      "owner": "platform",
      "objective": "Governed components/resources have explicit owner, lifecycle state and disposition.",
      "nist": [
        "GOVERN",
        "IDENTIFY"
      ],
      "soc2": [
        "Security",
        "Privacy"
      ],
      "frequency": "daily",
      "maxEvidenceAgeHours": 48,
      "evidence": [
        "P28 ownership registry",
        "P31 fleet registry",
        "live account app registry"
      ],
      "test": "registry_coverage"
    },
    {
      "id": "TH-GV-03",
      "title": "Exception and risk-acceptance governance",
      "owner": "platform",
      "objective": "Exceptions are exact, scoped, independently approved, expiring and unable to waive non-waivable controls.",
      "nist": [
        "GOVERN"
      ],
      "soc2": [
        "Security"
      ],
      "frequency": "per_exception",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P32 exception policy",
        "P33 evidence"
      ],
      "test": "exception_scope_expiry_independence"
    },
    {
      "id": "TH-GV-04",
      "title": "Cloud shared-responsibility governance",
      "owner": "platform",
      "objective": "Provider and THIEPN responsibilities and plan-dependent capabilities are explicitly understood.",
      "nist": [
        "GOVERN",
        "IDENTIFY"
      ],
      "soc2": [
        "Security",
        "Availability",
        "Confidentiality"
      ],
      "frequency": "quarterly",
      "maxEvidenceAgeHours": 2400,
      "evidence": [
        "Supabase current documentation",
        "P28 capability review",
        "P33 audit capability"
      ],
      "test": "provider_boundary_review"
    },
    {
      "id": "TH-ID-01",
      "title": "Asset and service inventory",
      "owner": "platform",
      "objective": "Production apps, shared services, database, Edge, cron and storage surfaces are inventoried and reconciled.",
      "nist": [
        "IDENTIFY"
      ],
      "soc2": [
        "Security",
        "Availability"
      ],
      "frequency": "daily",
      "maxEvidenceAgeHours": 48,
      "evidence": [
        "P28 resource inventory",
        "P31 fleet registry",
        "live Supabase inventory"
      ],
      "test": "live_inventory_reconciliation"
    },
    {
      "id": "TH-ID-02",
      "title": "Dependency and blast-radius inventory",
      "owner": "platform",
      "objective": "Direct/transitive dependencies are known before shared changes are admitted.",
      "nist": [
        "IDENTIFY",
        "GOVERN"
      ],
      "soc2": [
        "Security",
        "Availability",
        "Processing Integrity"
      ],
      "frequency": "per_change",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P29 graph",
        "P31 graph coverage",
        "impact analysis"
      ],
      "test": "dependency_graph_coverage"
    },
    {
      "id": "TH-PR-01",
      "title": "Identity and authentication safeguards",
      "owner": "account",
      "objective": "Authentication controls and high-risk Auth configuration are deliberately configured and periodically reviewed.",
      "nist": [
        "PROTECT"
      ],
      "soc2": [
        "Security",
        "Confidentiality",
        "Privacy"
      ],
      "frequency": "daily",
      "maxEvidenceAgeHours": 48,
      "evidence": [
        "Auth configuration",
        "Security Advisor",
        "account/session contracts"
      ],
      "test": "auth_configuration_assurance"
    },
    {
      "id": "TH-PR-02",
      "title": "Data authorization and row-level access",
      "owner": "platform",
      "objective": "Exposed data has intentional Data API privileges and RLS/policy design appropriate to callers.",
      "nist": [
        "PROTECT"
      ],
      "soc2": [
        "Security",
        "Confidentiality",
        "Privacy"
      ],
      "frequency": "daily",
      "maxEvidenceAgeHours": 48,
      "evidence": [
        "RLS inventory",
        "grants",
        "Security Advisor",
        "P32 Data API policies"
      ],
      "test": "exposure_rls_grant_review"
    },
    {
      "id": "TH-PR-03",
      "title": "Secrets and privileged credential protection",
      "owner": "platform",
      "objective": "Privileged credentials are not exposed to public clients or canonical evidence/source.",
      "nist": [
        "PROTECT"
      ],
      "soc2": [
        "Security",
        "Confidentiality"
      ],
      "frequency": "per_change",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P32 secret guardrails",
        "P33 privacy contracts",
        "CI"
      ],
      "test": "secret_exposure_negative_tests"
    },
    {
      "id": "TH-PR-04",
      "title": "Privileged database function safety",
      "owner": "platform",
      "objective": "SECURITY DEFINER functions are intentional, narrowly callable and enforce internal authorization.",
      "nist": [
        "PROTECT"
      ],
      "soc2": [
        "Security",
        "Confidentiality"
      ],
      "frequency": "daily",
      "maxEvidenceAgeHours": 48,
      "evidence": [
        "function definitions",
        "EXECUTE grants",
        "Security Advisor"
      ],
      "test": "security_definer_disposition"
    },
    {
      "id": "TH-PR-05",
      "title": "Software supply-chain and CI integrity",
      "owner": "platform",
      "objective": "Production workflows use reviewed source, immutable action references and deterministic policy tests.",
      "nist": [
        "PROTECT",
        "GOVERN"
      ],
      "soc2": [
        "Security",
        "Processing Integrity"
      ],
      "frequency": "per_change",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P22 supply-chain contract",
        "P32 policy integrity",
        "GitHub workflows"
      ],
      "test": "workflow_pin_and_ci_integrity"
    },
    {
      "id": "TH-PR-06",
      "title": "Data lifecycle export and deletion governance",
      "owner": "account",
      "objective": "Export/deletion operations are explicit, authorized, evidenced and protected against unsafe destructive action.",
      "nist": [
        "PROTECT",
        "GOVERN"
      ],
      "soc2": [
        "Privacy",
        "Confidentiality",
        "Processing Integrity"
      ],
      "frequency": "per_change",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P17 lifecycle",
        "account deletion/export contracts",
        "P32 destructive-action guardrail"
      ],
      "test": "lifecycle_and_destructive_action_contract"
    },
    {
      "id": "TH-DE-01",
      "title": "Security posture monitoring and triage",
      "owner": "platform",
      "objective": "Security Advisor and related security posture signals are captured, classified, aged and dispositioned.",
      "nist": [
        "DETECT"
      ],
      "soc2": [
        "Security"
      ],
      "frequency": "daily",
      "maxEvidenceAgeHours": 48,
      "evidence": [
        "Supabase Security Advisor",
        "P34 deficiency register"
      ],
      "test": "advisor_snapshot_and_deficiency_aging"
    },
    {
      "id": "TH-DE-02",
      "title": "Audit logging and change provenance",
      "owner": "platform",
      "objective": "Material governance/release changes can be reconstructed from source, approval, workflow and live-state evidence.",
      "nist": [
        "DETECT",
        "GOVERN"
      ],
      "soc2": [
        "Security",
        "Processing Integrity"
      ],
      "frequency": "per_change",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P33 anchored ledger",
        "P33 provenance packs",
        "Git history",
        "provider logs when available"
      ],
      "test": "anchored_ledger_and_provenance_verification"
    },
    {
      "id": "TH-DE-03",
      "title": "Configuration and release drift detection",
      "owner": "platform",
      "objective": "Unexpected schema, migration, Edge, cron and registry changes invalidate stale release evidence.",
      "nist": [
        "DETECT",
        "IDENTIFY"
      ],
      "soc2": [
        "Security",
        "Availability",
        "Processing Integrity"
      ],
      "frequency": "daily",
      "maxEvidenceAgeHours": 48,
      "evidence": [
        "P20 drift",
        "P29 epoch binding",
        "P31 reconciliation",
        "P33 attestations"
      ],
      "test": "live_registry_epoch_reconciliation"
    },
    {
      "id": "TH-RS-01",
      "title": "Incident detection coordination and recovery decision",
      "owner": "platform",
      "objective": "Incidents have scoped coordination, evidence, bounded response and explicit destructive-recovery decisions.",
      "nist": [
        "RESPOND"
      ],
      "soc2": [
        "Security",
        "Availability"
      ],
      "frequency": "per_incident",
      "maxEvidenceAgeHours": 168,
      "evidence": [
        "P21 incident/recovery",
        "P31 incident leases",
        "P33 incident evidence"
      ],
      "test": "incident_runbook_and_recovery_guardrail"
    },
    {
      "id": "TH-RC-01",
      "title": "Backup restore and recovery assurance",
      "owner": "platform",
      "objective": "Backup/recovery evidence exists and destructive restoration is explicitly governed.",
      "nist": [
        "RECOVER"
      ],
      "soc2": [
        "Availability",
        "Processing Integrity"
      ],
      "frequency": "monthly",
      "maxEvidenceAgeHours": 840,
      "evidence": [
        "P15 recovery snapshots",
        "restore plans",
        "P21 recovery validation"
      ],
      "test": "backup_and_restore_evidence"
    },
    {
      "id": "TH-RC-02",
      "title": "Availability SLO and capacity resilience",
      "owner": "platform",
      "objective": "Health, capacity and release observations are measured and regressions prevent certification.",
      "nist": [
        "RECOVER",
        "IDENTIFY",
        "DETECT"
      ],
      "soc2": [
        "Availability"
      ],
      "frequency": "monthly",
      "maxEvidenceAgeHours": 840,
      "evidence": [
        "P25/P26 baseline",
        "P27 SLO/capacity",
        "P30 observation",
        "Performance Advisor"
      ],
      "test": "health_slo_capacity_assurance"

    "platformAuditLogs": {
      "available": false,
      "reason": "Supabase Platform Audit Logs are documented as Team/Enterprise only"
    },
    "authAuditLogs": {
      "postgresRowsObserved": 0,
      "rawRowsCopiedIntoGit": false
    },
    "postgresConnectionLogging": "off",
    "pgauditInstalled": false,
    "pgStatStatementsInstalled": true,
    "pgCronInstalled": true,
    "automaticConfigurationChangeByP33": false
  },
  "retentionClasses": {
    "release_certificate": {
      "minimumDays": 730,
      "containsPersonalData": false
    },
    "admission_decision": {
      "minimumDays": 365,
      "containsPersonalData": false
    },
    "production_attestation": {
      "minimumDays": 365,
      "containsPersonalData": false
    },
    "exception_record": {
      "minimumDays": 730,
      "containsPersonalData": false
    },
    "incident_evidence": {
      "minimumDays": 730,
      "containsPersonalData": "minimized"
    },
    "workflow_artifact": {
      "minimumDays": 30,
      "canonical": false
    },
    "raw_provider_log": {
      "retention": "provider_plan_dependent",
      "canonical": false
    }

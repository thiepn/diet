      "examples": [
        "project health",
        "migration head",
        "schema fingerprint",
        "Edge version/SHA",
        "cron inventory",
        "advisor result"
      ],
      "trust": "live_platform_observation"
    },
    {
      "id": "supabase_native_audit",
      "examples": [
        "Auth audit logs",
        "Platform Audit Logs",
        "Postgres logs"
      ],
      "trust": "provider_native_evidence",
      "availability": "plan_and_configuration_dependent"
    },
    {
      "id": "human_approval",
      "examples": [
        "production approval",
        "cost approval",
        "exception approver",
        "incident decision"
      ],
      "trust": "explicit_review_evidence"
    },
    {
      "id": "derived_policy",
      "examples": [
        "P32 admission decision",
        "P31 can-release",
        "P30 promotion decision",
        "P29 compatibility certificate"
      ],
      "trust": "deterministic_derived_evidence"
    }
  ],
  "currentAuditCapability": {

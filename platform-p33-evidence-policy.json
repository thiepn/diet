  "provenanceChainRequired": [
    "change manifest",
    "P32 admission decision",
    "P29 impact analysis/compatibility evidence when applicable",
    "P30 immutable candidate and promotion decisions when applicable",
    "P31 fleet release decision",
    "human approvals where required",
    "deployment/workflow identity",
    "post-deploy live attestation",
    "final release certificate or failure/abort record"
  ],
  "ledgerRules": {
    "format": "JSONL",
    "hashAlgorithm": "SHA-256",
    "canonicalization": "UTF-8 JSON with sorted keys and compact separators",
    "entryHashInput": "entire entry excluding entryHash",
    "previousHashRequiredAfterGenesis": true,
    "sequenceStrictlyIncreasingByOne": true,
    "eventIdUnique": true,
    "timestampRequired": true,
    "deletionForbidden": true,
    "mutationOfExistingEntryForbidden": true,
    "correctionModel": "append superseding/correction event; never rewrite prior entry"
  },
  "evidencePackRules": {
    "deterministicFileHashes": true,
    "artifactOrderSortedByLogicalName": true,
    "rootHashAlgorithm": "SHA-256 over canonical sorted evidence manifest",
    "missingRequiredArtifact": "fail",
    "mutableUrlAloneInsufficient": true,
    "exactCommitOrRunIdentityRequired": true
  },
  "privacyRules": {
    "doNotStore": [
      "access tokens",
      "refresh tokens",
      "service-role keys",
      "database passwords",
      "raw IP addresses in Git evidence",
      "raw user-agent strings in Git evidence",
      "raw auth audit log payloads",
      "user email addresses unless strictly required and separately approved"
    ],
    "allowedAggregates": [
      "audit row counts",
      "time ranges",
      "status/result counts",
      "non-personal resource identifiers",
      "cryptographic hashes"
    ]
  },
  "completionRequires": [
    "P32 certified complete",
    "canonical ledger verifies from genesis to head",
    "provenance pack builder produces deterministic root hash",
    "tampered ledger entry is detected",
    "deleted/reordered ledger entry is detected",
    "missing required provenance artifact is detected",
    "historical correction is append-only",
    "sensitive raw provider audit data never enters Git evidence",
    "at least one complete release chain is captured end-to-end",
    "final evidence/audit handbook committed"
  ]
}

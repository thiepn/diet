  "evidencePrinciples": {
    "appendOnlyLogicalLedger": true,
    "tamperEvidentHashChain": true,
    "gitReviewRequiredForCanonicalLedgerMutation": true,
    "rawSecretsForbidden": true,
    "rawAuthAuditRowsForbidden": true,
    "personalDataMinimization": true,
    "evidenceMustNameSourceAndTimestamp": true,
    "observedFactsSeparatedFromDerivedJudgments": true,
    "historicalEvidenceNeverSilentlyRewritten": true,
    "complianceCertificationClaimed": false
  },
  "sourceClasses": [
    {
      "id": "github_source",
      "examples": [
        "commit SHA",
        "PR number/head",
        "workflow run",
        "job conclusion",
        "artifact checksum"

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p32-change-manifest.schema.json",
  "title": "P32 governed change admission manifest",
  "type": "object",
  "required": [
    "changeId",
    "requester",
    "owner",
    "components",
    "changeClass",
    "scopes",
    "resources",
    "mutationTypes",
    "targetEnvironment",
    "riskSignals",
    "requestedPaidResources",
    "productionMutationRequested",
    "p29ImpactComplete",
    "requiredTrainType",
    "now",
    "policyBundleVersion",
    "fleetRegistryVersion",
    "releaseRegistryVersion"
  ],
  "properties": {
    "changeId": {
      "type": "string",
      "minLength": 1
    },
    "requester": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "changeClass": {
      "enum": [
        "consumer_only",
        "provider_additive",
        "provider_breaking",
        "data_migration_no_contract",
        "infrastructure_contract",
        "operational_job"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "mutationTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "targetEnvironment": {
      "enum": [
        "ci",
        "preview",
        "staging",
        "production"
      ]
    },
    "riskSignals": {
      "type": "object"
    },
    "requestedPaidResources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "productionMutationRequested": {
      "type": "boolean"
    },
    "p29ImpactComplete": {
      "type": "boolean"
    },
    "requiredTrainType": {
      "enum": [
        "app_fast",
        "shared_standard",
        "coordinated_breaking",
        "platform_maintenance"
      ]
    },
    "affectedConsumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "humanApprovals": {
      "type": "object"
    },
    "integrationEnvironment": {
      "type": "object"
    },
    "intent": {
      "type": "string"
    },
    "candidateId": {
      "type": "string"
    },
    "claimsP31Eligible": {
      "type": "boolean"
    },
    "p31Decision": {
      "type": "object"
    },
    "policyBundleVersion": {
      "type": "string",
      "minLength": 1
    },
    "fleetRegistryVersion": {
      "type": "string",
      "minLength": 1
    },
    "releaseRegistryVersion": {
      "type": "string",
      "minLength": 1
    },
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "policyIds",
          "owner",
          "approver",
          "reason",
          "reference",
          "createdAt",
          "expiresAt",
          "scopes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "policyIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "approver": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

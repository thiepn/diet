{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p31-release-intent.schema.json",
  "title": "P31 fleet control-plane release intent",
  "type": "object",
  "required": [
    "trainId",
    "candidateId",
    "trainType",
    "components",
    "scopes",
    "fleetRegistryVersion",
    "releaseRegistryVersion",
    "p29CertificateStatus",
    "p30PromotionStatus",
    "targetStage",
    "now"
  ],
  "properties": {
    "trainId": {
      "type": "string",
      "minLength": 1
    },
    "candidateId": {
      "type": "string",
      "minLength": 1
    },
    "trainType": {
      "enum": [
        "app_fast",
        "shared_standard",
        "coordinated_breaking",
        "platform_maintenance"
      ]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "fleetRegistryVersion": {
      "type": "string",
      "minLength": 1
    },
    "releaseRegistryVersion": {
      "type": "string",
      "minLength": 1
    },
    "p29CertificateStatus": {
      "enum": [
        "pass",
        "fail",
        "missing"
      ]
    },
    "p30PromotionStatus": {
      "enum": [
        "pass",
        "fail",
        "missing"
      ]
    },
    "integrationEnvironmentKind": {
      "enum": [
        "logical",
        "local_supabase_ephemeral",
        "isolated_supabase_project",
        "supabase_branch"
      ]
    },
    "targetStage": {
      "enum": [
        "candidate",
        "integration",
        "production_ready",
        "production",
        "observation",
        "certified"
      ]
    },
    "manualProductionApproval": {
      "type": "object",
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "approvalRef": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "now": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p34-deficiency.schema.json",
  "title": "P34 assurance deficiency",
  "type": "object",
  "required": [
    "id",
    "title",
    "controlIds",
    "severity",
    "state",
    "owner",
    "source",
    "observedAt",
    "requiredClosureEvidence",
    "automaticRemediation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P34-D[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "controlIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^TH-[A-Z]{2}-[0-9]{2}$"
      }
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "state": {
      "enum": [
        "open",
        "accepted_temporarily",
        "remediating",
        "ready_for_retest",
        "closed"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "requiredClosureEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "automaticRemediation": {
      "const": false
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "acceptedBy": {
      "type": "string"
    },
    "decisionRef": {
      "type": "string"
    },
    "executiveDecisionRef": {
      "type": "string"
    },
    "remediationEvidenceHashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "closureEvidenceHashes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "closedAt": {
      "type": "string",
      "format": "date-time"
    },
    "retestAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}

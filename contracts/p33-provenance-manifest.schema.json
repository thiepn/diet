{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p33-provenance-manifest.schema.json",
  "title": "P33 provenance pack manifest",
  "type": "object",
  "required": [
    "changeId",
    "subject",
    "git",
    "workflows",
    "chainRefs",
    "privacy",
    "ledgerAnchorPath",
    "requiredArtifacts"
  ],
  "properties": {
    "changeId": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "git": {
      "type": "object",
      "required": [
        "repository",
        "commitSha"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pullRequest": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "runId",
          "conclusion"
        ]
      }
    },
    "chainRefs": {
      "type": "object",
      "required": [
        "p29MergeSha",
        "p30MergeSha",
        "p31MergeSha",
        "p32MergeSha"
      ]
    },
    "liveAttestation": {
      "type": "object"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "containsRawSecrets",
        "containsRawPersonalAuditData",
        "containsRawNetworkIdentifiers"
      ],
      "properties": {
        "containsRawSecrets": {
          "const": false
        },
        "containsRawPersonalAuditData": {
          "const": false
        },
        "containsRawNetworkIdentifiers": {
          "const": false
        }
      }
    },
    "ledgerAnchorPath": {
      "type": "string",
      "minLength": 1
    },
    "requiredArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "sourceClass": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}

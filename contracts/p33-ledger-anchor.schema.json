{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p33-ledger-anchor.schema.json",
  "title": "P33 reviewed audit ledger head anchor",
  "type": "object",
  "required": [
    "schemaVersion",
    "phase",
    "ledgerFile",
    "ledgerPolicyVersion",
    "generatedAt",
    "entryCount",
    "headSequence",
    "headEventId",
    "headHash",
    "ledgerSha256",
    "sourceMainSha",
    "hashAlgorithm"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "phase": {
      "const": "P33"
    },
    "ledgerFile": {
      "type": "string",
      "minLength": 1
    },
    "ledgerPolicyVersion": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entryCount": {
      "type": "integer",
      "minimum": 1
    },
    "headSequence": {
      "type": "integer",
      "minimum": 0
    },
    "headEventId": {
      "type": "string",
      "minLength": 1
    },
    "headHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledgerSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceMainSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "hashAlgorithm": {
      "const": "SHA-256"
    },
    "anchorPurpose": {
      "type": "string"
    }
  },
  "additionalProperties": true
}

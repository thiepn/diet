{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p34-audit-package-manifest.schema.json",
  "title": "P34 audit-readiness package manifest",
  "type": "object",
  "required": [
    "scope",
    "periodStart",
    "periodEnd",
    "readinessStatement",
    "readinessLevel",
    "externalAttestation",
    "frameworkMappings",
    "openDeficiencyIds",
    "assessmentResultPath",
    "deficiencyRegisterPath",
    "p33LedgerPath",
    "p33AnchorPath",
    "requiredArtifacts"
  ],
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "periodStart": {
      "type": "string",
      "format": "date-time"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time"
    },
    "readinessStatement": {
      "type": "string",
      "minLength": 1
    },
    "readinessLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "externalAttestation": {
      "const": false
    },
    "frameworkMappings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "openDeficiencyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P34-D[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "assessmentResultPath": {
      "type": "string",
      "minLength": 1
    },
    "deficiencyRegisterPath": {
      "type": "string",
      "minLength": 1
    },
    "p33LedgerPath": {
      "type": "string",
      "minLength": 1
    },
    "p33AnchorPath": {
      "type": "string",
      "minLength": 1
    },
    "requiredArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p35-evidence-period.schema.json",
  "title": "P35 operating-effectiveness evidence period",
  "type": "object",
  "required": [
    "periodId",
    "periodStart",
    "periodEnd",
    "expectedChangeIds"
  ],
  "properties": {
    "periodId": {
      "type": "string",
      "minLength": 1
    },
    "periodStart": {
      "type": "string",
      "format": "date-time"
    },
    "periodEnd": {
      "type": "string",
      "format": "date-time"
    },
    "expectedChangeIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}

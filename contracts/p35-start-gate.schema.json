{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p35-start-gate.schema.json",
  "title": "P35 operating-effectiveness period start gate",
  "type": "object",
  "required": [
    "periodId",
    "mode",
    "observedAt",
    "scopedEpochStableMinutes",
    "criticalOpen",
    "highDeficiencyStates",
    "p32Mode",
    "p33LedgerVerified",
    "controlCatalogFrozen",
    "evidenceCollectorContractPass",
    "explicitAuthorization",
    "p34CatalogVersion",
    "p34SnapshotVersion",
    "p33HeadHash",
    "p33AnchorSha256",
    "controlCatalogSha256",
    "p34SnapshotSha256",
    "requestedBy",
    "authorizedBy"
  ],
  "properties": {
    "periodId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "operating"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scopedEpochStableMinutes": {
      "type": "number",
      "minimum": 0
    },
    "criticalOpen": {
      "type": "integer",
      "minimum": 0
    },
    "highDeficiencyStates": {
      "type": "object"
    },
    "p32Mode": {
      "enum": [
        "shadow",
        "warn",
        "enforce",
        "production"
      ]
    },
    "p33LedgerVerified": {
      "type": "boolean"
    },
    "controlCatalogFrozen": {
      "type": "boolean"
    },
    "evidenceCollectorContractPass": {
      "type": "boolean"
    },
    "explicitAuthorization": {
      "type": "boolean"
    },
    "p34CatalogVersion": {
      "type": "string"
    },
    "p34SnapshotVersion": {
      "type": "string"
    },
    "p33HeadHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "p33AnchorSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "controlCatalogSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "p34SnapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1
    },
    "authorizedBy": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thiepn.dev/contracts/p35-audit-dry-run-manifest.schema.json",
  "title": "P35 audit dry-run manifest",
  "type": "object",
  "required": [
    "statement",
    "externalAttestation",
    "periodDays",
    "operatingEffectivenessStatus",
    "unexplainedFailures",
    "sections",
    "artifacts",
    "deficiencies"
  ],
  "properties": {
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "externalAttestation": {
      "const": false
    },
    "periodDays": {
      "type": "integer",
      "minimum": 1
    },
    "operatingEffectivenessStatus": {
      "enum": [
        "pass",
        "fail",
        "not_started"
      ]
    },
    "unexplainedFailures": {
      "type": "integer",
      "minimum": 0
    },
    "sections": {
      "type": "object"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "deficiencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
